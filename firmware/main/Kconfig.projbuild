menu "Display Configuration"

    config DISPLAY_PIN_SDA
        int "I2C SDA GPIO"
        default 25
        help
            GPIO the display's SDA line is wired to.

    config DISPLAY_PIN_SCL
        int "I2C SCL GPIO"
        default 26
        help
            GPIO the display's SCL line is wired to.

    config DISPLAY_I2C_ADDR
        hex "I2C address"
        default 0x3C
        range 0x08 0x77
        help
            7-bit I2C address of the SSD1306, usually 0x3C, sometimes 0x3D.

endmenu
