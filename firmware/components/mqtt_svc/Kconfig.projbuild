menu "mqtt_svc Configuration"

    config MQTT_SVC_BROKER_URI
        string "MQTT Broker Uri"
        default "local.mybrokeruri"
        help
            Uri of the broker that the esp shall connect to within the network.
            Of form "mqtt://<hostname>.local:<port>".

    config MQTT_SVC_USERNAME
        string "MQTT Username"
        default ""
        help
            Username of the MQTT client used for authentication.
            Empty connects anonymously.

    config MQTT_SVC_PASSWORD
        string "MQTT Password"
        default ""
        help
            MQTT password used to authenticate at the broker.
            Empty sends no password.

    config MQTT_SVC_MAX_SUBSCRIPTIONS
        int "Maximum subscriptions"
        default 8
        range 1 64
        help
            Number of topic filters that can be subscribed at the same time.

    config MQTT_SVC_REPORT_EXPIRED
        bool "Report expired messages"
        default y
        select MQTT_REPORT_DELETED_MESSAGES
        help
            Enables esp-mqtt's MQTT_EVENT_DELETED for QoS 1 and 2 messages that expire in the
            outbox without an acknowledgement. Without it, on_delivery never reports a failure
            and mqtt_svc_flush cannot tell an expired message from a delivered one.
endmenu
