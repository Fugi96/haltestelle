# Copy to .env and uncomment what you need. Without a .env, all defaults apply.

# Host port of the web app, if 8000 is taken.
#WEB_APP_PORT=8080

# Host port of the bundled broker, if 1883 is taken. The app connects inside
# the Docker network and is unaffected.
#BUNDLED_BROKER_PORT=1884

# Your own broker instead of the bundled one: set its address and login, and
# disable the bundled broker, see compose.override.example.yaml.
# host.docker.internal is the machine Docker runs on.
#MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
